#!/bin/bash
#SBATCH --job-name=CheckAthene
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --time=01:00:00
#SBATCH --output=logs/athene_test%j.out
#SBATCH --error=logs/athene_test%j.err

set -euo pipefail

module purge
module load 2023
module load Anaconda3/2023.07-2

eval "$(conda shell.bash hook)"
conda activate verlenv
export WANDB_API_KEY=9dbe3f48ba14149757b7b5b73b02ef3e9cab94b5

echo "========== ENV INFO =========="
echo "Node: $(hostname)"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi
echo "=============================="

# Configuration 
MODEL_PATH="Nexusflow/Athene-RM-8B"
INPUT_FILE="athene_test.json"
OUTPUT_FILE="rewards_output.json"
BATCH_SIZE=4
LOG_FILE="rewards_${SLURM_JOB_ID}.log"

# Print configuration
echo "==================================="
echo "Athene Reward Scoring Job"
echo "==================================="
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURM_NODELIST"
echo "Model Path: $MODEL_PATH"
echo "Input File: $INPUT_FILE"
echo "Output File: $OUTPUT_FILE"
echo "Batch Size: $BATCH_SIZE"
echo "==================================="

# Run the scoring script
python check_athene.py \
    --model-path "$MODEL_PATH" \
    --input "$INPUT_FILE" \
    --output "$OUTPUT_FILE" \
    --batch-size $BATCH_SIZE \
    --device auto \
    --log-file "$LOG_FILE"p

echo "==================================="
echo "Job completed"
echo "Results saved to: $OUTPUT_FILE"
echo "Logs saved to: $LOG_FILE"
echo "==================================="

python check_athene.py --model-path "Nexusflow/Athene-RM-8B" \
    --input "athene_test.json" \
    --output "athene_out.json" \
    --batch-size 4 \
    --device auto \
    --log-file "athene.out"